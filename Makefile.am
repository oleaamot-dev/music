ACLOCAL_AMFLAGS = -I m4 ${ACLOCAL_FLAGS}
AM_DISTCHECK_CONFIGURE_FLAGS = --enable-werror

AM_CPPFLAGS = \
	-DLOCALEDIR=\""$(localedir)"\" \
	-DG_LOG_DOMAIN=\"GarageJam\" \
	-I$(top_srcdir)/src

# ------------------------------------------------------------------
# Program
# ------------------------------------------------------------------

bin_PROGRAMS = garagejam

garagejam_SOURCES = \
	src/main.c \
	src/gj-engine.c \
	src/gj-engine.h \
	src/gj-project.c \
	src/gj-project.h \
	src/gj-waveform.c \
	src/gj-waveform.h \
	src/gj-window.c \
	src/gj-window.h

garagejam_CFLAGS = $(GARAGEJAM_CFLAGS) $(WARN_CFLAGS)
garagejam_LDADD  = $(GARAGEJAM_LIBS) $(LIBS)

# ------------------------------------------------------------------
# Desktop integration
# ------------------------------------------------------------------

desktopdir = $(datadir)/applications
dist_desktop_DATA = data/org.garagejam.GarageJam.desktop

metainfodir = $(datadir)/metainfo
dist_metainfo_DATA = data/org.garagejam.GarageJam.metainfo.xml

mimedir = $(datadir)/mime/packages
dist_mime_DATA = data/org.garagejam.GarageJam.mime.xml

scalableicondir = $(datadir)/icons/hicolor/scalable/apps
dist_scalableicon_DATA = data/icons/org.garagejam.GarageJam.svg

symbolicicondir = $(datadir)/icons/hicolor/symbolic/apps
dist_symbolicicon_DATA = data/icons/org.garagejam.GarageJam-symbolic.svg

man1_MANS = data/garagejam.1

dist_doc_DATA = README NEWS AUTHORS ChangeLog COPYING doc/gjxml.md

examplesdir = $(docdir)/examples
dist_examples_DATA = examples/demo.gjxml

EXTRA_DIST = \
	autogen.sh \
	data/garagejam.1.in \
	tests/data/sample.gjxml

DISTCLEANFILES = data/garagejam.1

gtk_update_icon_cache = gtk-update-icon-cache -f -t $(datadir)/icons/hicolor

install-data-hook:
	@-if test -z "$(DESTDIR)"; then \
	  echo "Updating icon cache and MIME database."; \
	  $(gtk_update_icon_cache) >/dev/null 2>&1 || :; \
	  update-mime-database $(datadir)/mime >/dev/null 2>&1 || :; \
	  update-desktop-database -q $(desktopdir) >/dev/null 2>&1 || :; \
	fi

# Caches regenerated by the hooks above are not ours to remove.
distuninstallcheck_listfiles = find . -type f -print | \
	grep -v -e 'share/mime/[^p]' -e 'share/mime/packages/[^o]' \
	        -e 'mimeinfo\.cache$$' -e 'icon-theme\.cache$$'

uninstall-hook:
	@-if test -z "$(DESTDIR)"; then \
	  $(gtk_update_icon_cache) >/dev/null 2>&1 || :; \
	  update-mime-database $(datadir)/mime >/dev/null 2>&1 || :; \
	fi

# ------------------------------------------------------------------
# Tests
# ------------------------------------------------------------------

check_PROGRAMS = tests/test-gjxml tests/test-peaks
TESTS = $(check_PROGRAMS)

tests_test_gjxml_SOURCES = tests/test-gjxml.c src/gj-project.c src/gj-project.h
tests_test_gjxml_CFLAGS  = $(GJCORE_CFLAGS) $(WARN_CFLAGS)
tests_test_gjxml_LDADD   = $(GJCORE_LIBS)

tests_test_peaks_SOURCES = tests/test-peaks.c src/gj-waveform.c src/gj-waveform.h \
	src/gj-project.c src/gj-project.h
tests_test_peaks_CFLAGS  = $(GARAGEJAM_CFLAGS) $(WARN_CFLAGS)
tests_test_peaks_LDADD   = $(GARAGEJAM_LIBS) $(LIBS)

if HAVE_DESKTOP_FILE_VALIDATE
TESTS += tests/validate-desktop.sh
endif
if HAVE_APPSTREAM_UTIL
TESTS += tests/validate-metainfo.sh
endif
AM_TESTS_ENVIRONMENT = \
	DESKTOP_FILE_VALIDATE="$(DESKTOP_FILE_VALIDATE)" \
	APPSTREAM_UTIL="$(APPSTREAM_UTIL)" \
	G_TEST_SRCDIR="$(abs_top_srcdir)/tests" \
	top_srcdir="$(top_srcdir)"; \
	export DESKTOP_FILE_VALIDATE APPSTREAM_UTIL G_TEST_SRCDIR top_srcdir;
EXTRA_DIST += tests/validate-desktop.sh tests/validate-metainfo.sh
